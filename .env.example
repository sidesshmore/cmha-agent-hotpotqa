# Nothing here is required for the default setup — Ollama runs locally with
# no API key at all. These only matter if you override the endpoint.

# --- Default: local Ollama (no key needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# OLLAMA_HOST=http://localhost:11434

# --- Alternative: point at a remote OpenAI-compatible endpoint instead ---
# (plain OpenAI, a hosted vLLM server, etc.) — only the chat
# calls go through LLM_BASE_URL/LLM_API_KEY; embeddings still expect an
# Ollama-shaped /api/embeddings route at OLLAMA_HOST, so keep a local Ollama
# running for embeddings even if you swap the chat backend.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# then override model names on the command line, e.g.:
#   python run_baseline.py --answer-model gpt-4o-mini --hypothesis-models gpt-4o-mini
